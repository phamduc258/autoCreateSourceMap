# Copy file nay thanh `.env` trong DU AN cua ban (recorder tu doc .env o thu muc dang chay).
# Tat ca deu TUY CHON — co the truyen qua CLI thay vi .env.

# URL mac dinh khi khong truyen <url> tren dong lenh
BASE_URL=https://example.com

# Dung trinh duyet HE THONG thay vi tai Chromium cua Playwright.
# Bo comment neu may KHONG tai duoc Chromium (vd CDN bi chan) -> dung Chrome/Edge da cai.
# BROWSER_CHANNEL=chrome

# Record man hinh SAU LOGIN: path file storageState (sinh tu test login truoc do)
# RECORD_STORAGE=.auth/state.json

# Timeout (ms) cho page.goto khi site rat cham (mac dinh 60000)
# RECORD_TIMEOUT=90000
