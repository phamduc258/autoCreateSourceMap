# Copy file nay thanh .env roi dien thong tin that.
# Xem giai thich day du cac bien o README muc 2.

# === Crawler (npm run crawl) ===
BASE_URL=https://your-test-site.example.com
TEST_USER=your_test_account
TEST_PASS=your_password

# === Trinh duyet — tuy chon ===
# Dung trinh duyet HE THONG cho CA crawler + test + recorder: 'chrome' hoac 'msedge'.
# Bat khi khong tai duoc Chromium dong goi (CDN bi chan) hoac no loi side-by-side (Windows). Xem README muc 8.3.
# BROWSER_CHANNEL=chrome
# Chi rieng recorder (uu tien hon BROWSER_CHANNEL neu dat ca hai):
# RECORD_CHANNEL=chrome

# Nap phien login da luu (lay tu crawler) de khoi dang nhap lai:
# RECORD_STORAGE=output/.auth/state.json

# Timeout (ms) mo trang cho recorder neu site rat cham (mac dinh 60000):
# RECORD_TIMEOUT=120000

# Loc loai selector giu trong 'unique':
# RECORD_SELECTORS=css,xpath,testId
